# Local Postgres for edb-token-tracker and dashboard
POSTGRES_DB=pi_token_usage
POSTGRES_USER=pi_token_tracker
POSTGRES_PASSWORD=pi_token_tracker
POSTGRES_PORT=5432

# Used by packages/edb-token-tracker and dashboard
DATABASE_URL=postgres://pi_token_tracker:pi_token_tracker@localhost:5432/pi_token_usage
# Optional extension-specific override:
# PI_TOKEN_TRACKER_DATABASE_URL=postgres://pi_token_tracker:pi_token_tracker@localhost:5432/pi_token_usage
